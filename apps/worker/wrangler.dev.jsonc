{
  "$schema": "https://developers.cloudflare.com/workers/configuration/wrangler-file/",
  "name": "mail-vault-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": false,

  "vars": {
    "ENVIRONMENT": "development",
    "DEV_AUTH_BYPASS": "true",
    "CF_ACCOUNT_ID": "",
    "MAIL_WORKER_NAME": "mail-vault",
    "APP_ORIGIN": "http://localhost:8787",
    "CF_ACCESS_TEAM_DOMAIN": "http://localhost:8787",
    "CF_ACCESS_AUD": "dev-bypass",
    "MAX_MESSAGE_BYTES": "20971520",
    "MAX_SENDS_PER_DAY": "50",
    "ALLOWED_EMAILS": "",
    "DOMAIN_DENYLIST": "tungjpstore.net,selinow.com,fball.vn,logivn.com",
    "DELIVERY_EVENTS_QUEUE": "mail-delivery-events"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-vault-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "mail-vault-storage"
    }
  ],

  // Same shape as production; wrangler creates the queue locally. Nothing writes
  // `mail-delivery-events` here — the local simulator sends no delivery events — but the
  // consumer is declared so a send-status change can be exercised by handing it records
  // directly, and so dev and production never disagree about what queues exist.
  "queues": {
    "producers": [
      { "binding": "MAIL_INGEST_QUEUE", "queue": "mail-ingest" }
    ],
    "consumers": [
      {
        "queue": "mail-ingest",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "mail-ingest-dlq"
      },
      { "queue": "mail-delivery-events", "max_batch_size": 20, "max_retries": 3 }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "MAILBOX_HUB", "class_name": "MailboxHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxHub"] }
  ],

  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "mailvault-events" }
  ],

  // Deliberately absent here, unlike production: an `ai` binding always talks to the real
  // Workers AI endpoint, so `wrangler dev` opens an authenticated remote proxy session for
  // it — which the CI job has no credentials for, and should not have. Semantic search is
  // opt-in and off by default, and the settings screen already reports it as unavailable
  // locally (there is no Vectorize backend in the dev config either).

  // The local simulator accepts this binding and logs instead of delivering, so the compose
  // path can be exercised end to end without a message ever reaching a real person.
  "send_email": [{ "name": "EMAIL" }],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
